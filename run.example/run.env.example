# Machine-local settings for run/remote.sh. Copy to run/run.env (gitignored) and fill in.
# Never commit real host names, home directories or internal store paths.

# Required: the GPU host, as user@host or an alias from ~/.ssh/config.
NN_REMOTE_HOST=YOUR_HOST

# Required: absolute path of this checkout on the remote host.
NN_REMOTE_REPO=/path/to/repo

# Optional: the nn executable on the remote host, relative to NN_REMOTE_REPO or absolute.
# NN_REMOTE_NN=.venv/bin/nn
